{
  "entities": {
    "consultation": {
      "title": "Consultation",
      "description": "User consultation requests.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "contacted", "closed"] },
        "createdAt": { "type": "number", "description": "Firestore server timestamp" }
      },
      "required": ["userId", "name", "email", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/consultations/{consultationId}": {
      "schema": { "$ref": "#/entities/consultation" },
      "description": "Store consultation requests."
    }
  }
}
